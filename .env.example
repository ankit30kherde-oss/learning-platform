# ---------------------------------------------------------------------------
# Copy this file to .env  ->  cp .env.example .env
# NEVER commit .env. In AWS these values come from Secrets Manager (see README).
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Databases (database-per-service, one Postgres instance in dev) ---------
AUTH_DATABASE_URL=postgresql://lp:lp_password@localhost:5432/auth_db?schema=public
COURSE_DATABASE_URL=postgresql://lp:lp_password@localhost:5432/course_db?schema=public
ENROLLMENT_DATABASE_URL=postgresql://lp:lp_password@localhost:5432/enrollment_db?schema=public
PAYMENT_DATABASE_URL=postgresql://lp:lp_password@localhost:5432/payment_db?schema=public
MEDIA_DATABASE_URL=postgresql://lp:lp_password@localhost:5432/media_db?schema=public
LAB_DATABASE_URL=postgresql://lp:lp_password@localhost:5432/lab_db?schema=public
QUIZ_DATABASE_URL=postgresql://lp:lp_password@localhost:5432/quiz_db?schema=public
CERT_DATABASE_URL=postgresql://lp:lp_password@localhost:5432/certificate_db?schema=public
NOTIFICATION_DATABASE_URL=postgresql://lp:lp_password@localhost:5432/notification_db?schema=public

# --- Redis (cache + dev event bus; ElastiCache + EventBridge in prod) -------
REDIS_URL=redis://localhost:6379

# --- Ports -----------------------------------------------------------------
GATEWAY_PORT=4000
AUTH_PORT=4001
COURSE_PORT=4002
ENROLLMENT_PORT=4003
PAYMENT_PORT=4004
MEDIA_PORT=4005
LAB_PORT=4006
QUIZ_PORT=4007
CERT_PORT=4008
NOTIFICATION_PORT=4009
WEB_PORT=3000

# --- Internal service URLs (gateway -> services) ---------------------------
AUTH_SERVICE_URL=http://localhost:4001
COURSE_SERVICE_URL=http://localhost:4002
ENROLLMENT_SERVICE_URL=http://localhost:4003
PAYMENT_SERVICE_URL=http://localhost:4004
MEDIA_SERVICE_URL=http://localhost:4005
LAB_SERVICE_URL=http://localhost:4006
QUIZ_SERVICE_URL=http://localhost:4007
CERT_SERVICE_URL=http://localhost:4008
NOTIFICATION_SERVICE_URL=http://localhost:4009

# --- JWT -------------------------------------------------------------------
# Dev only. Generate real ones with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev_access_secret_change_me_0123456789abcdef
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_abcdef0123456789
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
JWT_ISSUER=learning-platform
JWT_AUDIENCE=learning-platform-web

# --- Cookies ---------------------------------------------------------------
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Internal service-to-service auth --------------------------------------
INTERNAL_API_KEY=dev_internal_key_change_me

# --- Mail (MailHog in dev, SES in prod) ------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DevOps Academy <no-reply@devopsacademy.local>"
APP_PUBLIC_URL=http://localhost:3000

# --- Razorpay (TEST MODE keys; get from dashboard.razorpay.com) ------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_dev_change_me
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
PAYMENTS_CURRENCY=INR

# --- Media (MinIO in dev, S3 + CloudFront in prod) -------------------------
# MEDIA_DRIVER=s3 presigns against S3/MinIO. Set it to cloudfront in production
# and fill in the three CLOUDFRONT_* values from Terraform's outputs.
MEDIA_DRIVER=s3
MEDIA_BUCKET=lp-media-dev
MEDIA_URL_TTL=300
MEDIA_TRANSCODE=false
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
AWS_REGION=ap-south-1
# CLOUDFRONT_DOMAIN=d111111abcdef8.cloudfront.net
# CLOUDFRONT_KEY_PAIR_ID=K2JCJMDEHXQW5F
# CLOUDFRONT_PRIVATE_KEY_B64=   # base64 of the PEM, from Secrets Manager

# --- Labs ------------------------------------------------------------------
# LAB_DRIVER=kubernetes on EKS; anything else uses the local Docker driver,
# which is what makes the lab lesson work inside Codespaces.
LAB_DRIVER=local
LAB_IMAGE=alpine:3.20
LAB_MAX_SESSIONS_PER_USER=1

# --- Certificates ----------------------------------------------------------
# Signs the HMAC printed on every certificate. Rotating it invalidates
# verification for existing certificates, so treat it as long-lived.
CERTIFICATE_SIGNING_SECRET=dev_certificate_secret_change_me

# --- Frontend --------------------------------------------------------------
NEXT_PUBLIC_API_BASE=/api
GATEWAY_INTERNAL_URL=http://localhost:4000
# Browser -> gateway WebSocket for the lab terminal. In Codespaces replace this
# with the forwarded https URL of port 4000 (the app converts it to wss).
NEXT_PUBLIC_GATEWAY_WS_URL=http://localhost:4000

# --- Security --------------------------------------------------------------
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120
CORS_ORIGINS=http://localhost:3000
