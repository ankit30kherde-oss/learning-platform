
#!/usr/bin/env bash

# ============================================================
# Learning Platform - GitHub Codespaces Startup Script
# ============================================================
# Usage:
#   ./scripts/start-codespace.sh
#
# Optional:
#   SKIP_SEED=true ./scripts/start-codespace.sh
#   START_APP=false ./scripts/start-codespace.sh
# ============================================================

set -Eeuo pipefail

# -----------------------------
# Configuration
# -----------------------------
MAX_RETRIES="${MAX_RETRIES:-30}"
RETRY_SECONDS="${RETRY_SECONDS:-2}"
SKIP_SEED="${SKIP_SEED:-false}"
START_APP="${START_APP:-true}"

# Change this if your repository uses another Compose file.
COMPOSE_FILE="${COMPOSE_FILE:-docker-compose.yml}"

# -----------------------------
# Output helpers
# -----------------------------
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log() {
  echo -e "${BLUE}[INFO]${NC} $1"
}

success() {
  echo -e "${GREEN}[OK]${NC} $1"
}

warn() {
  echo -e "${YELLOW}[WARN]${NC} $1"
}

error() {
  echo -e "${RED}[ERROR]${NC} $1" >&2
}

step() {
  echo
  echo "============================================================"
  echo " $1"
  echo "============================================================"
}

# -----------------------------
# Failure handler
# -----------------------------
cleanup_on_error() {
  error "Startup failed near line $1."
  error "Check the logs using:"
  echo "  docker compose -f \"$COMPOSE_FILE\" logs --tail=100"
}

trap 'cleanup_on_error $LINENO' ERR

# -----------------------------
# Retry helper
# -----------------------------
# Usage:
#   wait_until "Description" command arg1 arg2
#
# The command must return 0 when the check succeeds.
# -----------------------------
wait_until() {
  local description="$1"
  shift

  local attempt=1

  log "$description"

  while (( attempt <= MAX_RETRIES )); do
    if "$@" >/dev/null 2>&1; then
      success "$description"
      return 0
    fi

    echo "  Attempt $attempt/$MAX_RETRIES: not ready"

    if (( attempt == MAX_RETRIES )); then
      error "Timeout waiting for: $description"
      return 1
    fi

    sleep "$RETRY_SECONDS"
    ((attempt++))
  done
}

# -----------------------------
# Run a command with status
# -----------------------------
run_step() {
  local description="$1"
  shift

  log "$description"

  if "$@"; then
    success "$description"
  else
    error "Failed: $description"
    return 1
  fi
}

# -----------------------------
# Check a TCP port
# -----------------------------
check_port() {
  local host="$1"
  local port="$2"

  if command -v nc >/dev/null 2>&1; then
    nc -z "$host" "$port"
  else
    timeout 3 bash -c "</dev/tcp/$host/$port" 2>/dev/null
  fi
}

# -----------------------------
# Check PostgreSQL
# -----------------------------
check_postgres() {
  local container="$1"

  docker exec "$container" pg_isready >/dev/null 2>&1
}

# -----------------------------
# Check Redis
# -----------------------------
check_redis() {
  local container="$1"

  docker exec "$container" redis-cli ping 2>/dev/null | grep -q PONG
}

# -----------------------------
# Show Compose status
# -----------------------------
show_status() {
  echo
  log "Current Docker Compose status:"
  docker compose -f "$COMPOSE_FILE" ps || true
}

# ============================================================
# MAIN
# ============================================================

step "1. Checking repository"

if [[ ! -f package.json ]]; then
  error "package.json not found."
  error "Run this script from the learning-platform repository root."
  exit 1
fi

if [[ ! -f "$COMPOSE_FILE" ]]; then
  error "Compose file not found: $COMPOSE_FILE"
  exit 1
fi

success "Repository and Compose file found"

# ============================================================

step "2. Checking required commands"

for command_name in docker node pnpm; do
  if command -v "$command_name" >/dev/null 2>&1; then
    success "$command_name is installed"
  else
    error "$command_name is not installed or not in PATH"
    exit 1
  fi
done

docker compose version
node --version
pnpm --version

# ============================================================

step "3. Checking Docker daemon"

if ! docker info >/dev/null 2>&1; then
  error "Docker daemon is not running or is not accessible."
  exit 1
fi

success "Docker daemon is available"

# ============================================================

step "4. Installing dependencies"

run_step "Installing pnpm dependencies" pnpm install

# ============================================================

step "5. Starting infrastructure containers"

run_step \
  "Starting Docker Compose infrastructure" \
  docker compose -f "$COMPOSE_FILE" up -d

show_status

# ============================================================

step "6. Waiting for containers"

wait_until \
  "Waiting for all Compose services to become healthy/running" \
  bash -c '
    containers=$(docker compose -f "$1" ps -q)
    test -n "$containers"

    for container in $containers; do
      state=$(docker inspect \
        --format "{{.State.Status}}" "$container")

      test "$state" = "running"

      health=$(docker inspect \
        --format "{{if .State.Health}}{{.State.Health.Status}}{{else}}no-healthcheck{{end}}" \
        "$container")

      if [[ "$health" == "unhealthy" ]]; then
        exit 1
      fi

      if [[ "$health" == "starting" ]]; then
        exit 1
      fi
    done
  ' _ "$COMPOSE_FILE"

show_status

# ============================================================

step "7. Checking PostgreSQL"

# Automatically find running Compose containers whose image
# appears to be PostgreSQL.
POSTGRES_CONTAINER="$(
  docker compose -f "$COMPOSE_FILE" ps -q |
  while read -r container; do
    image=$(docker inspect --format '{{.Config.Image}}' "$container")
    if [[ "$image" == *postgres* ]]; then
      echo "$container"
      break
    fi
  done
)"

if [[ -n "$POSTGRES_CONTAINER" ]]; then
  wait_until \
    "Waiting for PostgreSQL readiness" \
    check_postgres "$POSTGRES_CONTAINER"
else
  warn "No PostgreSQL container detected. Skipping this check."
fi

# ============================================================

step "8. Checking Redis"

REDIS_CONTAINER="$(
  docker compose -f "$COMPOSE_FILE" ps -q |
  while read -r container; do
    image=$(docker inspect --format '{{.Config.Image}}' "$container")
    if [[ "$image" == *redis* ]]; then
      echo "$container"
      break
    fi
  done
)"

if [[ -n "$REDIS_CONTAINER" ]]; then
  wait_until \
    "Waiting for Redis readiness" \
    check_redis "$REDIS_CONTAINER"
else
  warn "No Redis container detected. Skipping this check."
fi

# ============================================================

step "9. Running database migrations"

run_step "Running database migrations" pnpm db:migrate

# ============================================================

step "10. Seeding database"

if [[ "$SKIP_SEED" == "true" ]]; then
  warn "Database seed skipped because SKIP_SEED=true"
else
  run_step "Seeding database" pnpm db:seed
fi

# ============================================================

step "11. Bootstrapping MinIO"

if [[ -f scripts/bootstrap-minio.sh ]]; then
  run_step \
    "Running MinIO bootstrap script" \
    bash scripts/bootstrap-minio.sh
else
  warn "scripts/bootstrap-minio.sh not found. Skipping MinIO bootstrap."
fi

# ============================================================

step "12. Final infrastructure status"

show_status

# ============================================================

step "13. Starting application"

if [[ "$START_APP" == "false" ]]; then
  warn "START_APP=false. Infrastructure is ready."
  echo
  echo "Start the application manually with:"
  echo "  pnpm dev"
  exit 0
fi

success "Infrastructure and initialization completed"
log "Starting the development application..."
echo

exec pnpm dev